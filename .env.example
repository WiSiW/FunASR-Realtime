# Backend
FUNASR_APP_NAME=FunASR Realtime API
FUNASR_MODEL_REVISION=v2.0.4
FUNASR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CPU 推理线程数。默认 2 可为浏览器/系统保留 CPU，减少识别时卡顿。
FUNASR_TORCH_NUM_THREADS=2
FUNASR_TORCH_INTEROP_THREADS=1
FUNASR_VAD_ENERGY=0.012
FUNASR_VAD_HANGOVER_SEC=0.6
FUNASR_VAD_MIN_SPEECH_SEC=0.25
FUNASR_VAD_MAX_SPEECH_SEC=30
FUNASR_MAX_PUSH_SEC=120
FUNASR_PRELOAD_MODELS=offline,streaming
FUNASR_PRELOAD_STRICT=true

# Docker Compose
# PRELOAD_MODELS=true 会在 docker build 时下载并固化模型缓存
PRELOAD_MODELS=true
FRONTEND_PORT=8080
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org

# Frontend: normally unnecessary in local development because Vite proxies /api.
# VITE_API_TARGET=http://127.0.0.1:8000
# VITE_WS_URL=ws://127.0.0.1:8000/api/v1/asr/stream

# Backend
FUNASR_APP_NAME=FunASR Realtime API
FUNASR_MODEL_REVISION=v2.0.4
FUNASR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CPU 推理线程数。默认 2 可为浏览器/系统保留 CPU，减少识别时卡顿。
FUNASR_TORCH_NUM_THREADS=2
FUNASR_TORCH_INTEROP_THREADS=1
FUNASR_VAD_ENERGY=0.012
FUNASR_VAD_HANGOVER_SEC=0.6
FUNASR_VAD_MIN_SPEECH_SEC=0.25
FUNASR_VAD_MAX_SPEECH_SEC=30
FUNASR_VAD_PRE_ROLL_SEC=0.4
FUNASR_MAX_PUSH_SEC=120
FUNASR_PRELOAD_MODELS=offline,streaming
FUNASR_PRELOAD_STRICT=true
# 常驻模型服务：API 重启后复用已加载模型，不会重新加载权重
FUNASR_MODEL_DAEMON=on
FUNASR_MODEL_DAEMON_AUTOSTART=true
FUNASR_MODEL_DAEMON_HOST=127.0.0.1
FUNASR_MODEL_DAEMON_PORT=8765
FUNASR_MODEL_DAEMON_AUTHKEY=funasr-realtime-model-daemon
FUNASR_MODEL_DAEMON_START_TIMEOUT=600
FUNASR_MODEL_DAEMON_SESSION_TTL=1800
FUNASR_MODEL_DAEMON_MAX_WORKERS=8
FUNASR_MODEL_DAEMON_BACKLOG=64
FUNASR_MODEL_DAEMON_PID_FILE=~/.cache/funasr-realtime/model-daemon.pid
# true 时只驻留 offline/streaming 中的一个，避免内存不足导致 daemon 卡死
FUNASR_MODEL_DAEMON_SINGLE_ASR_MODEL=true
# 启动 API 时是否强制重载常驻模型；平时保持 false
FUNASR_RELOAD_MODELS=false
# 说话人识别：会话内输出 speaker_01、speaker_02...
# 可选把 speaker 加入预加载：FUNASR_PRELOAD_MODELS=offline,streaming,speaker
FUNASR_SPEAKER_ENABLED=true
FUNASR_SPEAKER_MODEL=cam++
FUNASR_SPEAKER_MODEL_REVISION=master
FUNASR_SPEAKER_DB=~/.cache/funasr-realtime/speakers.sqlite3
FUNASR_SPEAKER_SIMILARITY_THRESHOLD=0.70
FUNASR_SPEAKER_NEW_THRESHOLD=0.45
FUNASR_SPEAKER_ENROLLED_MATCH_THRESHOLD=0.70
FUNASR_SPEAKER_SWITCH_MARGIN=0.08
FUNASR_SPEAKER_MIN_SEGMENT_SEC=0.8
FUNASR_SPEAKER_MAX_SPEAKERS=8
FUNASR_SPEAKER_EMBEDDING_WINDOW_SEC=1.5
FUNASR_SPEAKER_EMBEDDING_INTERVAL_SEC=0.8
FUNASR_SPEAKER_CENTROID_UPDATE_ALPHA=0.1
# ASR 文本后处理：纠错、保守口语清洗、按标点/长度断句
FUNASR_ASR_POSTPROCESS=true
FUNASR_ASR_CLEAN_FILLERS=true
FUNASR_ASR_CORRECTION_FILE=
FUNASR_ASR_MAX_SENTENCE_CHARS=40
FUNASR_ASR_MIN_SENTENCE_CHARS=6

# Docker Compose
# PRELOAD_MODELS=true 会在 docker build 时下载并固化模型缓存
PRELOAD_MODELS=true
FRONTEND_PORT=8080
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org

# Frontend: normally unnecessary in local development because Vite proxies /api.
# VITE_API_TARGET=http://127.0.0.1:8000
# VITE_WS_URL=ws://127.0.0.1:8000/api/v1/asr/stream
